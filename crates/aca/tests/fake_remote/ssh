#!/bin/sh
# Fake ssh: `ssh -o … -- HOST 'sh -s'` runs the script from stdin on this machine, with HOME set to $FAKE/remote (the home on
# the remote machine).
# A host named nohost cannot be reached
while [ $# -gt 0 ]; do
  case $1 in
    -o) shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
host=$1
shift
echo "$host $*" >>"$FAKE/ssh.log"
if [ "$host" = nohost ]; then
  echo "ssh: Could not resolve hostname nohost: nodename nor servname provided, or not known" >&2
  exit 255
fi
mkdir -p "$FAKE/remote"
HOME="$FAKE/remote" exec sh -s
